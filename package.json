  "description": "Browse and manage Shortcut stories from a Kanban board inside bb.",
  "license": "MIT",
  "author": "Andreas McDermott",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreasmcdermott/bb-plugin-shortcut.git"
  },
  "homepage": "https://github.com/andreasmcdermott/bb-plugin-shortcut#readme",
  "bugs": {
